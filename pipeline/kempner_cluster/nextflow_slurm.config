nextflow.enable.strict = false

params.backend = 'slurm'
params.executor = 'slurm'
params.default_queue = 'shared'
params.gpu_queue = 'kempner'
def data_path = System.getenv('DATA_PATH') ?: "${baseDir}/../../data"
def data_bind = "--bind ${data_path}:/tmp/data"
def slurm_account = System.getenv('DEFAULT_ACCOUNT') ?: 'kempner_dev'
def account_option = slurm_account ? "--account=${slurm_account}" : ''
// The classifier's CUDA 13 runtime needs Turing (sm_75) or newer. The kempner partition
// (A100) has no MIG slices, so a plain --gres=gpu:1 gets a full GPU.
def gpu_cluster_options = System.getenv('GPU_CLUSTER_OPTIONS') ?: '--gres=gpu:1'
def image_library = System.getenv('NXF_SINGULARITY_LIBRARYDIR') ?: '/n/holylfs06/LABS/kempner_shared/Everyone/workflow/ophys-roi-extraction-2026/images'
// Task scripts create /data, /results, /scratch, and other root links. SIF
// files are read-only, so provide an ephemeral writable upper layer.
def writable_tmpfs = '--writable-tmpfs'

env {
    PIPELINE_NAME = "aind-pophys-pipeline"
    PIPELINE_VERSION = new File("${projectDir}/nextflow.config").text.find(/PIPELINE_VERSION = "([^"]+)"/) { match, version -> version }
    PIPELINE_URL = "https://github.com/AllenNeuralDynamics/aind-pophys-pipeline"
    // Python in the containers ignores packages in the user's home directory.
    PYTHONNOUSERSITE = "1"
}

// The release version; it tags the step images unless --container_tag or CONTAINER_TAG is set.
params.pipeline_version = env.PIPELINE_VERSION

def hasApptainer = ['bash', '-c', 'command -v apptainer'].execute().waitFor() == 0
def hasSingularity = ['bash', '-c', 'command -v singularity'].execute().waitFor() == 0

if (hasApptainer) {
    apptainer {
        enabled = true
        autoMounts = true
        platform = 'linux/amd64'
        libraryDir = System.getenv('NXF_APPTAINER_LIBRARYDIR') ?: image_library
        // Converting the 3.4 GB classifier image to SIF can exceed the 20-minute default.
        pullTimeout = '2h'
        envWhitelist = ['MPLCONFIGDIR', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
    }
} else if (hasSingularity) {
    singularity {
        enabled = true
        autoMounts = true
        platform = 'linux/amd64'
        libraryDir = image_library
        // Converting the 3.4 GB classifier image to SIF can exceed the 20-minute default.
        pullTimeout = '2h'
        envWhitelist = ['MPLCONFIGDIR', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
    }
} else {
    throw new RuntimeException('Neither apptainer nor singularity found in PATH')
}

// Slurm job names are visible to all users; keep step names out of them.
executor {
    jobName = { "nf-${task.index}" }
}

process {
    executor = 'slurm'
    queue = params.default_queue
    clusterOptions = account_option
    containerOptions = "${writable_tmpfs} ${data_bind}"
    errorStrategy = 'terminate'
    maxForks = 4
    // setuptools cannot build aind-ophys-dff-library in an NFS work dir ([Errno 39] Directory not
    // empty on build/bdist.*), so each task runs on node-local disk and copies its outputs back.
    scratch = '/scratch'

    withName: converter {
        cpus = 16
        memory = '128 GB'
        time = '1d'
    }
    withName: motion_correction {
        cpus = 16
        memory = '128 GB'
        time = '1d'
    }
    withName: movie_qc {
        cpus = 16
        memory = '128 GB'
        time = '1d'
    }
    withName: decrosstalk_split_json {
        cpus = 2
        memory = '16 GB'
        time = '4h'
    }
    withName: decrosstalk_roi_images {
        cpus = 8
        memory = '64 GB'
        time = '1d'
    }
    withName: extraction {
        cpus = 8
        memory = '64 GB'
        time = '1d'
    }
    withName: dff {
        cpus = 4
        memory = '32 GB'
        time = '12h'
    }
    withName: oasis_event_detection {
        cpus = 4
        memory = '32 GB'
        time = '12h'
    }
    withName: classifier {
        containerOptions = "${writable_tmpfs} --nv ${data_bind}"
        clusterOptions = "${account_option} ${gpu_cluster_options}".trim()
        queue = params.gpu_queue ?: params.default_queue
        time = '1d'
    }
    withName: ophys_nwb {
        cpus = 4
        memory = '32 GB'
        time = '12h'
    }
    withName: pipeline_processing_metadata_aggregator {
        cpus = 2
        memory = '16 GB'
        time = '4h'
    }
}

// Public buckets such as aind-open-data need no credentials; set S3_ANONYMOUS=true.
aws {
    client {
        anonymous = (System.getenv('S3_ANONYMOUS') ?: 'false').toBoolean()
    }
}

dag {
    enabled = true
    file = System.getenv('RESULTS_PATH') + '/nextflow/dag.html'
    overwrite = true
}

report {
    enabled = true
    file = System.getenv('RESULTS_PATH') + '/nextflow/report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = System.getenv('RESULTS_PATH') + '/nextflow/timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = System.getenv('RESULTS_PATH') + '/nextflow/trace.txt'
    overwrite = true
}
